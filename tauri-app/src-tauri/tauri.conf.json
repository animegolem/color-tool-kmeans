{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Color Tool",
  "version": "1.0.0",
  "identifier": "com.color.tool",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5175",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: asset: tauri:; media-src 'self' data: blob: asset: tauri:; font-src 'self' data:; style-src 'self' 'unsafe-inline';",
      "devCsp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    },
    "windows": [
      {
        "title": "Color Tool",
        "width": 1360,
        "height": 860,
        "minWidth": 720,
        "minHeight": 600,
        "decorations": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["bin/ffmpeg", "bin/ffprobe"]
  }
}
