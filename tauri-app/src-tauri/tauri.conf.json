{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Color Tool",
  "version": "0.0.1",
  "identifier": "com.color.tool",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5175",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: asset: tauri:; font-src 'self' data:; style-src 'self' 'unsafe-inline';",
      "devCsp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    },
    "windows": [
      {
        "title": "Color Tool",
        "width": 1280,
        "height": 860,
        "decorations": true
      }
    ]
  },
  "bundle": {
    "active": false,
    "targets": ["deb", "appimage", "msi"],
    "icon": [],
    "externalBin": ["bin/ffmpeg", "bin/ffprobe"]
  }
}
