{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Color Tool",
  "version": "0.0.1",
  "identifier": "com.color.tool",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5175",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Color Tool",
        "width": 1280,
        "height": 860,
        "decorations": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["app", "appimage", "nsis"],
    "icon": [
      "icons/icon.png",
      "icons/icon-square.png",
      "icons/icon-1024.png",
      "icons/icon-512.png",
      "icons/icon-256.png",
      "icons/icon-128.png",
      "icons/icon-64.png",
      "icons/icon-32.png",
      "icons/icon-16.png",
      "icons/icon.ico"
    ]
  }
}
