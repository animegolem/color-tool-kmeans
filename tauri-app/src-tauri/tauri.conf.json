{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Color Tool",
  "version": "0.0.1",
  "identifier": "com.color.tool",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5175",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Color Tool",
        "width": 1280,
        "height": 860,
        "decorations": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "appimage",
      "nsis"
    ],
    "icon": [
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png",
      "icons/128x128@2x.png",
      "icons/128x128.png",
      "icons/64x64.png",
      "icons/32x32.png"
    ]
  }
}