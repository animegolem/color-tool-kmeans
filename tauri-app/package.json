{
  "name": "tauri-app",
  "version": "1.0.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run wasm:build && tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write . \"!dist/**\" \"!coverage/**\" \"!.svelte-kit/**\" \"!.turbo/**\" \"!.ffmpeg-build/**\" \"!src-tauri/target/**\" \"!src-tauri/.fingerprint/**\" \"!src-tauri/gen/**\" \"!src-tauri/bin/**\"",
    "format:check": "prettier --check . \"!dist/**\" \"!coverage/**\" \"!.svelte-kit/**\" \"!.turbo/**\" \"!.ffmpeg-build/**\" \"!src-tauri/target/**\" \"!src-tauri/.fingerprint/**\" \"!src-tauri/gen/**\" \"!src-tauri/bin/**\"",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:browser": "playwright test",
    "wasm:build": "node ../scripts/wasm/build.mjs",
    "wasm:parity": "node ../scripts/wasm/parity.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-dialog": "2.8.3",
    "@tauri-apps/plugin-store": "2.5.0",
    "svelte": "^5.0.3",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@tauri-apps/cli": "^2.9.6",
    "@types/node": "^22.13.1",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.9.0",
    "eslint-plugin-svelte": "^2.46.1",
    "fast-check": "^3.18.0",
    "prettier": "^3.3.2",
    "prettier-plugin-svelte": "^3.4.0",
    "svelte-check": "^4.3.2",
    "tslib": "^2.6.2",
    "typescript": "^5.4.0",
    "vite": "^7.1.7",
    "vitest": "^1.6.0"
  }
}
