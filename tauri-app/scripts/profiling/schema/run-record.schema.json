{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://color-tool.invalid/profiling/run-record.v1.schema.json",
  "title": "Color Tool profiling run record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "kind",
    "id",
    "buildRef",
    "caseRef",
    "operation",
    "attempts",
    "evidence"
  ],
  "properties": {
    "version": { "const": 1 },
    "kind": { "const": "run" },
    "id": { "$ref": "#/$defs/opaqueId" },
    "buildRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "digestSha256"],
      "properties": {
        "id": { "$ref": "#/$defs/opaqueId" },
        "digestSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "caseRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "digestSha256",
        "sourceDigestSha256",
        "configDigestSha256",
        "requestedFrameSeconds",
        "achievedFrameSeconds",
        "frameStatus",
        "decodedFrameDigestSha256"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/opaqueId" },
        "digestSha256": { "$ref": "#/$defs/sha256" },
        "sourceDigestSha256": { "$ref": "#/$defs/sha256" },
        "configDigestSha256": { "$ref": "#/$defs/sha256" },
        "requestedFrameSeconds": { "$ref": "#/$defs/numericValue" },
        "achievedFrameSeconds": { "$ref": "#/$defs/numericValue" },
        "frameStatus": { "enum": ["exact", "unmatched", "unverified"] },
        "decodedFrameDigestSha256": { "$ref": "#/$defs/digestValue" }
      }
    },
    "operation": {
      "enum": [
        "analysis-rerun",
        "import",
        "seek",
        "playback",
        "navigation",
        "export",
        "batch",
        "values"
      ]
    },
    "attempts": {
      "type": "array",
      "maxItems": 10000,
      "items": { "$ref": "#/$defs/attempt" }
    },
    "evidence": {
      "type": "array",
      "maxItems": 10000,
      "items": { "$ref": "#/$defs/evidence" }
    }
  },
  "$defs": {
    "availability": {
      "if": { "properties": { "value": { "type": "null" } } },
      "then": {
        "properties": {
          "unavailableReason": { "$ref": "#/$defs/unavailableReason" }
        }
      },
      "else": {
        "properties": { "unavailableReason": { "type": "null" } }
      }
    },
    "opaqueId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "unavailableReason": {
      "enum": [
        "not-collected",
        "not-exposed",
        "not-applicable",
        "unverified",
        "control-failure",
        "source-missing"
      ]
    },
    "numericValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unavailableReason"],
      "properties": {
        "value": { "type": ["number", "null"], "minimum": 0 },
        "unavailableReason": {
          "anyOf": [{ "$ref": "#/$defs/unavailableReason" }, { "type": "null" }]
        }
      },
      "allOf": [{ "$ref": "#/$defs/availability" }]
    },
    "digestValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unavailableReason"],
      "properties": {
        "value": {
          "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
        },
        "unavailableReason": {
          "anyOf": [{ "$ref": "#/$defs/unavailableReason" }, { "type": "null" }]
        }
      },
      "allOf": [{ "$ref": "#/$defs/availability" }]
    },
    "evidenceRefs": {
      "type": "array",
      "maxItems": 10000,
      "items": { "$ref": "#/$defs/opaqueId" }
    },
    "strata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["process", "cache", "workload", "visibility"],
      "properties": {
        "process": { "enum": ["warm", "fresh", "unknown"] },
        "cache": { "enum": ["warm", "cold", "mixed", "unknown"] },
        "workload": {
          "enum": [
            "quiet-observed",
            "busy-observed",
            "owner-quiet-intent-busy-observed",
            "unknown"
          ]
        },
        "visibility": { "enum": ["visible", "hidden", "mixed", "unknown"] }
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "endpoint",
        "value",
        "unavailableReason",
        "unit",
        "clock",
        "method",
        "precision",
        "evidenceLevel",
        "evidenceRefs"
      ],
      "properties": {
        "endpoint": { "$ref": "#/$defs/opaqueId" },
        "value": { "type": ["number", "null"], "minimum": 0 },
        "unavailableReason": {
          "anyOf": [{ "$ref": "#/$defs/unavailableReason" }, { "type": "null" }]
        },
        "unit": { "enum": ["ms", "s", "count", "bytes", "ratio"] },
        "clock": { "$ref": "#/$defs/opaqueId" },
        "method": {
          "enum": [
            "ui-transcription",
            "app-log-interval",
            "instrument-span",
            "presented-observation"
          ]
        },
        "precision": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "evidenceLevel": {
          "enum": [
            "ui-transcription",
            "app-log",
            "instrumentation",
            "presented-evidence"
          ]
        },
        "evidenceRefs": { "$ref": "#/$defs/evidenceRefs" }
      },
      "allOf": [
        { "$ref": "#/$defs/availability" },
        {
          "if": { "properties": { "value": { "type": "number" } } },
          "then": { "properties": { "evidenceRefs": { "minItems": 1 } } }
        },
        {
          "oneOf": [
            {
              "properties": {
                "method": { "const": "ui-transcription" },
                "evidenceLevel": { "const": "ui-transcription" }
              }
            },
            {
              "properties": {
                "method": { "const": "app-log-interval" },
                "evidenceLevel": { "const": "app-log" }
              }
            },
            {
              "properties": {
                "method": { "const": "instrument-span" },
                "evidenceLevel": { "const": "instrumentation" }
              }
            },
            {
              "properties": {
                "method": { "const": "presented-observation" },
                "evidenceLevel": { "const": "presented-evidence" }
              }
            }
          ]
        }
      ]
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sequence",
        "role",
        "strata",
        "action",
        "terminals",
        "freshExecution",
        "measurements",
        "exclusionReason"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/opaqueId" },
        "sequence": { "type": "integer", "minimum": 0 },
        "role": { "enum": ["setup", "reset", "warmup", "measured"] },
        "strata": { "$ref": "#/$defs/strata" },
        "action": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "kind", "evidenceRefs"],
          "properties": {
            "id": { "$ref": "#/$defs/opaqueId" },
            "kind": {
              "enum": [
                "analysis-request",
                "import",
                "seek",
                "playback",
                "navigation",
                "export"
              ]
            },
            "evidenceRefs": { "$ref": "#/$defs/evidenceRefs" }
          }
        },
        "terminals": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "status", "reasonCode", "evidenceRefs"],
            "properties": {
              "id": { "$ref": "#/$defs/opaqueId" },
              "status": {
                "enum": [
                  "completed",
                  "failed",
                  "cancelled",
                  "stale",
                  "cache",
                  "deduped",
                  "timeout",
                  "unverified"
                ]
              },
              "reasonCode": {
                "anyOf": [{ "$ref": "#/$defs/opaqueId" }, { "type": "null" }]
              },
              "evidenceRefs": { "$ref": "#/$defs/evidenceRefs" }
            },
            "allOf": [
              {
                "if": {
                  "properties": { "status": { "const": "completed" } }
                },
                "then": { "properties": { "reasonCode": { "type": "null" } } },
                "else": {
                  "properties": { "reasonCode": { "$ref": "#/$defs/opaqueId" } }
                }
              }
            ]
          }
        },
        "freshExecution": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "evidenceRefs"],
          "properties": {
            "status": { "enum": ["proven", "unproven", "not-applicable"] },
            "evidenceRefs": { "$ref": "#/$defs/evidenceRefs" }
          },
          "allOf": [
            {
              "if": { "properties": { "status": { "const": "proven" } } },
              "then": { "properties": { "evidenceRefs": { "minItems": 1 } } }
            }
          ]
        },
        "measurements": {
          "type": "array",
          "maxItems": 10000,
          "items": { "$ref": "#/$defs/measurement" }
        },
        "exclusionReason": {
          "enum": [
            "setup",
            "reset",
            "warmup",
            "unproven-execution",
            "unavailable-measurement",
            "noncompleted",
            "wrong-source",
            "unmatched-frame",
            "visibility-caveat",
            "cache",
            "deduped",
            "timeout",
            "stale",
            "failed",
            "cancelled",
            "unverified",
            null
          ]
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "ref", "note"],
      "properties": {
        "id": { "$ref": "#/$defs/opaqueId" },
        "kind": {
          "enum": [
            "ui-transcription",
            "app-log",
            "instrumentation",
            "presented-evidence"
          ]
        },
        "ref": { "type": ["string", "null"] },
        "note": { "type": ["string", "null"] }
      }
    }
  }
}
